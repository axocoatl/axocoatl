Step 4 · The configuration
  would write /var/folders/20/jp1_0n3n7kndh6rnbqb5344m0000gn/T//axo-gate-b.1R9RwS/plan-no-machine/Library/Application Support/Axocoatl/config.yaml:
    + # Axocoatl — local Ollama setup
    + agents:
    +   # Default team. Lead owns the change; Scout and Reviewer are read-only
    +   # helpers it can delegate to once you opt in and approve their limits in
    +   # Team & budget. A new Session starts with Lead alone.
    +   - id: lead
    +     name: "Lead"
    +     provider: ollama
    +     model: "qwen3-coder:30b"
    +     role: autonomous
    +     tools: [read_file, list_dir, grep, glob, write_file, edit_file, bash]
    +     system_prompt: "Answer only with tool calls until the change is made and checked; then write a short summary of what you changed. You own this change: find the relevant code and tests (if you have helpers, ask scout to find code you do not know), make the change, run the check command from the project instructions (AXOCOATL.md) or the tests and fix failures, then check your diff against the task (if you have helpers, ask reviewer to review it) and fix each defect found."
    +     sampling:
    +       max_tokens: 4096
    + 
    +   - id: scout
    +     name: "Scout"
    +     provider: ollama
    +     model: "qwen3-coder:30b"
    +     role: worker
    +     tools: [read_file, list_dir, grep, glob, bash]
    +     writes: []
    +     system_prompt: "Answer the lead's question with file paths, line numbers and short evidence. Change nothing."
    +     sampling:
    +       max_tokens: 4096
    + 
    +   - id: reviewer
    +     name: "Reviewer"
    +     provider: ollama
    +     model: "gpt-oss:20b"
    +     role: worker
    +     tools: [read_file, list_dir, grep, glob, bash]
    +     writes: []
    +     system_prompt: "Review the described change. Check it against the task and against every contract and edge case the docs, comments and tests describe, one by one. Report each defect with file:line, or say you found none. Change nothing."
    +     sampling:
    +       max_tokens: 4096
    + 
    +   # Plain chat for `axocoatl chat`; not part of the default team.
    +   - id: assistant
    +     name: "Assistant"
    +     provider: ollama
    +     model: "qwen3-coder:30b"
    +     system_prompt: "You are a helpful assistant."
    +     tools: [read_file, list_dir, grep, glob]
    +     token_budget:
    +       per_execution: 16000
    +       per_call: 8192
    +       overflow_policy: warn
    + 
    + providers:
    +   ollama:
    +     base_url: "http://127.0.0.1:49230"
    + 
    + # Defaults for `axocoatl run`: writer_model and reviewer_model.
    + # `--model writer=PROVIDER:MODEL` or `--model reviewer=…` overrides them.
    + # Writer: ollama (axocoatl run fix)
    + run:
    +   models:
    +     writer: "ollama:qwen3-coder:30b"
    +     reviewer: "ollama:gpt-oss:20b"
    + 
    + server:
    +   port: 8200
    +   host: "127.0.0.1"

